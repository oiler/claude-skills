{
  "source": "https://developers.google.com/style/word-list",
  "pinned": "2026-07-07",
  "entries": [
    {"term": "a number of", "verdict": "avoid", "replacement": "several, many, or the actual number", "note": "Vague quantity. Give the reader the number when you know it.", "anchor": "a-number-of"},
    {"term": "abort", "verdict": "avoid", "replacement": "stop, cancel, or halt", "note": "Violent and imprecise. Name the action that actually happens.", "anchor": "abort"},
    {"term": "allows you to", "verdict": "avoid", "replacement": "lets you", "note": "Shorter, and the product is not granting permission.", "anchor": "allow"},
    {"term": "and/or", "verdict": "avoid", "replacement": "or, or name both cases", "note": "Ambiguous and hard to translate. Write out the cases you mean.", "anchor": "and-or"},
    {"term": "as a service", "verdict": "restricted", "replacement": "spell out the offering", "note": "Marketing shorthand. Fine in a product name, weak in prose.", "anchor": "as-a-service"},
    {"term": "at this point in time", "verdict": "avoid", "replacement": "now, or cut the phrase", "note": "Padding.", "anchor": "at-this-point-in-time"},
    {"term": "backwards compatible", "verdict": "prefer", "replacement": "backward compatible", "note": "No trailing s on the adjective.", "anchor": "backward-compatible"},
    {"term": "blacklist", "verdict": "avoid", "replacement": "denylist or blocklist", "note": "Non-inclusive. The replacement is also more literal.", "anchor": "blacklist"},
    {"term": "check the checkbox", "verdict": "prefer", "replacement": "select the checkbox", "note": "Google's interaction verb for a checkbox is select, and clear for the reverse.", "anchor": "checkbox"},
    {"term": "click on", "verdict": "prefer", "replacement": "click", "note": "You click a button, not on it.", "anchor": "click"},
    {"term": "desire", "verdict": "avoid", "replacement": "want", "note": "Plain word.", "anchor": "desire"},
    {"term": "drop down", "verdict": "prefer", "replacement": "drop-down list", "note": "Hyphenated as a modifier, and it needs the noun it modifies.", "anchor": "drop-down"},
    {"term": "dummy", "verdict": "avoid", "replacement": "placeholder, sample, or example", "note": "Non-inclusive and vague.", "anchor": "dummy"},
    {"term": "e-mail", "verdict": "prefer", "replacement": "email", "note": "One word, no hyphen.", "anchor": "email"},
    {"term": "execute", "verdict": "restricted", "replacement": "run", "note": "Fine for a program executing an instruction; use run for what the reader does.", "anchor": "execute"},
    {"term": "functionality", "verdict": "avoid", "replacement": "features, capabilities, or behavior", "note": "Abstract noun standing in for a specific one.", "anchor": "functionality"},
    {"term": "grayed out", "verdict": "avoid", "replacement": "unavailable or dimmed", "note": "Describes appearance, not state, and fails for readers who cannot see it.", "anchor": "grayed-out"},
    {"term": "greyed out", "verdict": "avoid", "replacement": "unavailable or dimmed", "note": "Also the non-American spelling.", "anchor": "grayed-out"},
    {"term": "hit", "verdict": "avoid", "replacement": "press, click, or call", "note": "Name the real interaction.", "anchor": "hit"},
    {"term": "in order to", "verdict": "avoid", "replacement": "to", "note": "Two words of padding in front of every purpose clause.", "anchor": "in-order-to"},
    {"term": "in the event that", "verdict": "avoid", "replacement": "if", "note": "Padding.", "anchor": "in-the-event-that"},
    {"term": "info", "verdict": "prefer", "replacement": "information", "note": "Spell it out outside UI labels.", "anchor": "info"},
    {"term": "irregardless", "verdict": "prefer", "replacement": "regardless", "note": "Not a word.", "anchor": "irregardless"},
    {"term": "kill", "verdict": "avoid", "replacement": "stop, cancel, or end", "note": "Violent. The exception is a literal kill command in code font, which the checker already ignores.", "anchor": "kill"},
    {"term": "leverage", "verdict": "avoid", "replacement": "use", "note": "Business jargon for a plain verb.", "anchor": "leverage"},
    {"term": "login to", "verdict": "prefer", "replacement": "log in to", "note": "Two words as a verb, one word as a noun or adjective.", "anchor": "log-in"},
    {"term": "master", "verdict": "restricted", "replacement": "primary, main, or original", "note": "Non-inclusive in master/slave pairings. A git branch named master is a literal name and belongs in code font.", "anchor": "master"},
    {"term": "native", "verdict": "restricted", "replacement": "built-in, integrated, or the platform's name", "note": "Ambiguous and carries a second meaning about people.", "anchor": "native"},
    {"term": "prior to", "verdict": "avoid", "replacement": "before", "note": "Plain word.", "anchor": "prior-to"},
    {"term": "repo", "verdict": "restricted", "replacement": "repository", "note": "Spell it out on first use in reference material.", "anchor": "repo"},
    {"term": "slave", "verdict": "avoid", "replacement": "replica, secondary, or worker", "note": "Non-inclusive.", "anchor": "slave"},
    {"term": "subsequent to", "verdict": "avoid", "replacement": "after", "note": "Plain word.", "anchor": "subsequent-to"},
    {"term": "terminate", "verdict": "avoid", "replacement": "stop or end", "note": "Plain word.", "anchor": "terminate"},
    {"term": "type in", "verdict": "prefer", "replacement": "enter", "note": "Enter covers typing, pasting, and dictating.", "anchor": "enter"},
    {"term": "uncheck", "verdict": "prefer", "replacement": "clear", "note": "Google's verb for clearing a checkbox.", "anchor": "checkbox"},
    {"term": "under the hood", "verdict": "avoid", "replacement": "internally, or describe the mechanism", "note": "Idiom that does not translate.", "anchor": "under-the-hood"},
    {"term": "utilize", "verdict": "avoid", "replacement": "use", "note": "Longer word, same meaning.", "anchor": "utilize"},
    {"term": "web site", "verdict": "prefer", "replacement": "website", "note": "One word.", "anchor": "website"},
    {"term": "whitelist", "verdict": "avoid", "replacement": "allowlist", "note": "Non-inclusive. The replacement is also more literal.", "anchor": "whitelist"},
    {"term": "wish", "verdict": "avoid", "replacement": "want", "note": "Plain word.", "anchor": "wish"}
  ]
}
